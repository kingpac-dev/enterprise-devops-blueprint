# Normalize line endings so files authored on Windows behave correctly
# on Linux build agents and inside containers.

* text=auto eol=lf

# Files that must keep LF regardless of local settings.
# CRLF in these breaks shell execution and container builds on Linux.
*.sh            text eol=lf
*.bash          text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.dockerfile    text eol=lf
.dockerignore   text eol=lf
Jenkinsfile     text eol=lf
Jenkinsfile.*   text eol=lf
*.groovy        text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.env.example   text eol=lf

# Windows-only scripts keep CRLF.
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Binary assets: never convert, never diff as text.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.zip           binary
*.gz            binary
