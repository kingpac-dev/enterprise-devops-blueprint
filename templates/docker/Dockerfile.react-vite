# syntax=docker/dockerfile:1
#
# React + TypeScript + Vite application — multi-stage build, non-root runtime.
#
# Implements: docs/06-container/dockerfile-standard.md
#             docs/06-container/docker-standard.md
#
# Copy to your repository as `Dockerfile` and adjust the marked values.
#
# TBD before use:
#   - Node version, and whether it is pinned by digest
#   - nginx-unprivileged version, and whether it is pinned by digest
#
# RUNTIME CONFIGURATION — the reason this file differs from a stock Vite
# Dockerfile.
#
# Vite substitutes `import.meta.env.VITE_*` at BUILD time. A stock setup
# therefore produces a DIFFERENT ARTIFACT PER ENVIRONMENT, which breaks
# build-once promotion: the bundle in production is not the bundle UAT
# verified.
#
# This image is built ONCE and promoted unchanged. Environment values are
# written to config.json at container start by
# docker-entrypoint.d/10-runtime-config.sh and read by the application at
# bootstrap. Nothing environment-specific is compiled in.


# --------------------------------------------------------------------------
# Build stage
# --------------------------------------------------------------------------
FROM node:22.11-alpine AS build

WORKDIR /src

# Lockfile first, so a source change does not invalidate the install layer.
# `npm ci` installs the lockfile exactly and fails if it disagrees with
# package.json — `npm install` may resolve differently and rewrite it.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# No VITE_* build arguments. Any value passed here would be COMPILED IN,
# which is the failure this template exists to prevent.
RUN npm run build

# Vite emits to dist/ by default. ADJUST if your `build.outDir` differs.


# --------------------------------------------------------------------------
# Runtime stage
# --------------------------------------------------------------------------
# nginx-unprivileged runs as uid 101 and listens on 8080 by default, which
# satisfies the non-root and above-1024 requirements without further work.
FROM nginxinc/nginx-unprivileged:1.27-alpine AS final

# Build metadata, supplied by the pipeline. NOT secrets — ARG values are
# readable in image history by anyone who can pull the image.
ARG VERSION=0.0.0
ARG GIT_COMMIT=unknown
ARG BUILD_TIMESTAMP=unknown
ARG REPOSITORY_URL=unknown

LABEL org.opencontainers.image.title="react-app" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_TIMESTAMP}" \
      org.opencontainers.image.source="${REPOSITORY_URL}" \
      org.opencontainers.image.vendor="TBD"

COPY nginx.react-vite.conf /etc/nginx/conf.d/default.conf

# The runtime-config script writes into the html directory at start, so the
# directory must be writable by the runtime user.
COPY --from=build --chown=101:101 /src/dist /usr/share/nginx/html
COPY --chown=101:101 runtime-config.react-vite.sh /docker-entrypoint.d/10-runtime-config.sh

# The base image's entrypoint runs only files in /docker-entrypoint.d that
# are EXECUTABLE, and skips the rest with a log line that is easy to miss.
# A build context created on Windows carries no executable bit, so without
# this the runtime configuration is silently never written.
RUN chmod +x /docker-entrypoint.d/10-runtime-config.sh

USER 101

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/healthz || exit 1

# The base image's entrypoint runs /docker-entrypoint.d/*.sh and then execs
# nginx, so signals reach nginx directly. Do not override it.
CMD ["nginx", "-g", "daemon off;"]
