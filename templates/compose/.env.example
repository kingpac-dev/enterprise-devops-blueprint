# Environment values — PLACEHOLDERS ONLY.
#
# Copy to deployment/<environment>/.env and fill in real values.
#
# The real .env is NEVER committed. It is held on the deployment target,
# readable only by the account that runs the deployment.
#
# If a real value is ever committed, the credential is compromised the moment
# it reaches a shared branch — every clone, fork, mirror, and CI cache
# retains it. Rotate it. Deleting the file is not remediation.
# See SECURITY.md.
#
# Every value below is required unless marked optional. A missing required
# value stops the deployment rather than starting with a default that might
# point at the wrong environment.

# --- Registry -------------------------------------------------------------
HARBOR_URL=harbor.example.internal
HARBOR_PROJECT=<your-team-project>

# --- Image versions -------------------------------------------------------
# Explicit, immutable tags. Never `latest`. These are the same identifiers
# promoted from UAT — nothing is rebuilt for production.
WEB_VERSION=<version>-<commit>
API_VERSION=<version>-<commit>
WORKER_VERSION=<version>-<commit>

# --- Ports (optional; defaults shown in the compose files) -----------------
WEB_PORT=8080
API_PORT=8081

# --- Application configuration --------------------------------------------
WEB_API_BASE_URL=https://api.example.internal

# --- Credentials ----------------------------------------------------------
# Supplied per environment. A value here NEVER appears in another
# environment's file. A shared credential turns a low-value DEV compromise
# into a production compromise.
#
# Supplied through Jenkins Credentials at deployment time, or written to this
# file on the target host by an authorized operator.
DB_CONNECTION_STRING=<set-per-environment>
JWT_SIGNING_KEY=<set-via-jenkins-credentials>
