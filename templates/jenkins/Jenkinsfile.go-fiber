// =========================================================================
// Jenkinsfile — Go Fiber API.
//
// Complete and runnable. See Jenkinsfile.template for the rationale behind
// the shared stages.
//
// DEPLOYMENT IS PULL-BASED. This pipeline does not connect to any runtime
// host. See adr/0010.
// =========================================================================

pipeline {

    agent { label 'linux-docker-go' }   // TBD

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '50', artifactNumToKeepStr: '50'))
        skipDefaultCheckout(true)
    }

    environment {
        APP_NAME       = 'orders-go-api'                      // ADJUST
        MAIN_PACKAGE   = './cmd/api'                          // ADJUST
        HARBOR_URL     = 'harbor.example.internal'            // TBD
        HARBOR_PROJ    = 'my-team'                            // TBD
        SONAR_HOST     = 'https://sonarqube.example.internal' // TBD
        SONAR_KEY      = 'orders-go-api'                      // ADJUST
        TRIVY_SEVERITY = 'HIGH,CRITICAL'                      // TBD
        // Keep Go caches in the workspace so cleanWs() removes them and they
        // are not shared between builds on a persistent agent.
        GOPATH      = "${WORKSPACE}/.go"
        GOCACHE     = "${WORKSPACE}/.gocache"
        GOMODCACHE  = "${WORKSPACE}/.gomodcache"
        CGO_ENABLED = '0'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_COMMIT_SHORT = sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                }
            }
        }

        stage('Compute identity') {
            steps {
                script {
                    def branch = env.BRANCH_NAME ?: 'unknown'
                    if (branch == 'main' || branch.startsWith('release/')) {
                        env.VERSION    = readFile('VERSION').trim()
                        env.IMAGE_TAG  = "${env.VERSION}-${env.GIT_COMMIT_SHORT}"
                        env.PROMOTABLE = 'true'
                    } else if (branch == 'develop') {
                        env.VERSION    = '0.0.0'
                        env.IMAGE_TAG  = "sha-${env.GIT_COMMIT_SHORT}"
                        env.PROMOTABLE = 'true'
                    } else {
                        env.VERSION    = '0.0.0'
                        env.IMAGE_TAG  = "unpublished-${env.GIT_COMMIT_SHORT}"
                        env.PROMOTABLE = 'false'
                    }
                    env.IMAGE_REF       = "${env.HARBOR_URL}/${env.HARBOR_PROJ}/${env.APP_NAME}:${env.IMAGE_TAG}"
                    env.BUILD_TIMESTAMP = sh(script: 'date -u +%Y-%m-%dT%H:%M:%SZ', returnStdout: true).trim()
                }
            }
        }

        stage('Restore dependencies') {
            steps {
                // `go mod download` resolves against go.sum, which pins every
                // module by hash. A mismatch fails here — the Go equivalent
                // of a locked restore.
                //
                // `go mod verify` re-checks that the downloaded modules match
                // those hashes, which is the supply-chain check rather than
                // merely a resolution one.
                sh '''
                    set -eu
                    go mod download
                    go mod verify
                '''
            }
        }

        stage('Lint and vet') {
            steps {
                sh '''
                    set -eu
                    go vet ./...
                    # TBD — golangci-lint, if adopted:
                    # golangci-lint run --timeout 5m
                '''
            }
        }

        stage('Verify tidy') {
            steps {
                // Fails if go.mod or go.sum are not what the source requires.
                // Catches a dependency added without committing the updated
                // module files — which would otherwise resolve differently on
                // a clean machine.
                sh '''
                    set -eu
                    cp go.mod go.mod.bak
                    cp go.sum go.sum.bak
                    go mod tidy
                    if ! diff -q go.mod go.mod.bak >/dev/null || ! diff -q go.sum go.sum.bak >/dev/null; then
                        echo "go.mod or go.sum is not tidy. Run 'go mod tidy' and commit the result."
                        mv go.mod.bak go.mod
                        mv go.sum.bak go.sum
                        exit 1
                    fi
                    rm -f go.mod.bak go.sum.bak
                '''
            }
        }

        stage('Build') {
            steps {
                sh '''
                    set -eu
                    go build -trimpath -o /dev/null "${MAIN_PACKAGE}"
                '''
            }
        }

        stage('Unit test and coverage') {
            steps {
                // -race detects data races, which are the defect class Go
                // makes easy to introduce and hard to reproduce. It requires
                // CGO, so it is enabled only for the test run — the shipped
                // binary is still built with CGO_ENABLED=0.
                sh '''
                    set -eu
                    CGO_ENABLED=1 go test ./... \
                      -race \
                      -coverprofile=coverage.out \
                      -covermode=atomic \
                      -timeout 5m
                    go tool cover -func=coverage.out | tail -1
                '''
            }
        }

        stage('Static analysis') {
            steps {
                withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                    sh '''
                        set +x
                        set -eu
                        sonar-scanner \
                          -Dsonar.host.url="${SONAR_HOST}" \
                          -Dsonar.token="${SONAR_TOKEN}" \
                          -Dsonar.projectKey="${SONAR_KEY}" \
                          -Dsonar.projectVersion="${VERSION}" \
                          -Dsonar.go.coverage.reportPaths=coverage.out
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Dependency and secret scan') {
            steps {
                sh '''
                    set -eu
                    # govulncheck reports only vulnerabilities in code paths
                    # the binary actually REACHES, which produces far less
                    # noise than a manifest-level scan. TBD whether adopted.
                    # go run golang.org/x/vuln/cmd/govulncheck@latest ./...

                    trivy fs --config trivy.yaml \
                      --scanners vuln,secret,misconfig \
                      --severity "${TRIVY_SEVERITY}" --exit-code 1 .
                '''
            }
        }

        stage('Docker build') {
            steps {
                sh '''
                    set -eu
                    docker build \
                      --build-arg MAIN_PACKAGE="${MAIN_PACKAGE}" \
                      --build-arg VERSION="${VERSION}" \
                      --build-arg GIT_COMMIT="${GIT_COMMIT_SHORT}" \
                      --build-arg BUILD_TIMESTAMP="${BUILD_TIMESTAMP}" \
                      --build-arg REPOSITORY_URL="${GIT_URL}" \
                      --tag "${IMAGE_REF}" .
                '''
            }
        }

        stage('Container scan') {
            steps {
                // A distroless Go image has almost no OS packages, so this
                // scan usually reports only what the Go binary itself pulled
                // in. A near-empty result here is expected, not suspicious.
                sh '''
                    set -eu
                    trivy image --config trivy.yaml \
                      --severity "${TRIVY_SEVERITY}" --exit-code 1 "${IMAGE_REF}"
                    trivy image --config trivy.yaml \
                      --format json --output "trivy-${APP_NAME}-${IMAGE_TAG}.json" "${IMAGE_REF}"
                '''
            }
        }

        stage('Generate SBOM') {
            steps {
                sh '''
                    set -eu
                    trivy image --format cyclonedx \
                      --output "sbom-${APP_NAME}-${IMAGE_TAG}.cdx.json" "${IMAGE_REF}"
                '''
            }
        }

        stage('Push to Harbor') {
            when { environment name: 'PROMOTABLE', value: 'true' }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'harbor-push',
                    usernameVariable: 'HARBOR_USER',
                    passwordVariable: 'HARBOR_PASSWORD'
                )]) {
                    sh '''
                        set +x
                        set -eu
                        echo "${HARBOR_PASSWORD}" | docker login "${HARBOR_URL}" \
                            --username "${HARBOR_USER}" --password-stdin
                        set -x
                        docker push "${IMAGE_REF}"
                        docker logout "${HARBOR_URL}"
                    '''
                }
                script {
                    env.IMAGE_DIGEST = sh(
                        script: 'docker inspect --format "{{index .RepoDigests 0}}" "${IMAGE_REF}"',
                        returnStdout: true
                    ).trim()
                }
            }
        }

        // -----------------------------------------------------------------
        // DEPLOY — pull-based. See adr/0010 and
        // docs/05-ci-cd/deployment-repository-standard.md
        //
        // This pipeline does NOT connect to a runtime host. It updates the
        // desired state in the deployment repository, asks Portainer to
        // synchronize, and WAITS FOR CONVERGENCE.
        //
        // The wait is the part a push model does not need. Without it the
        // pipeline cannot answer "did it deploy?", and rollback has no
        // trigger. deploy-gitops.sh reverts the desired state on timeout.
        //
        // [LIBRARY CANDIDATE] — identical in every pipeline.
        // -----------------------------------------------------------------
        stage('Deploy DEV') {
            when {
                allOf {
                    environment name: 'PROMOTABLE', value: 'true'
                    branch 'develop'
                }
            }
            steps {
                withCredentials([
                    string(credentialsId: 'deploy-repo-token', variable: 'DEPLOY_REPO_TOKEN'),
                    string(credentialsId: 'portainer-webhook-dev', variable: 'PORTAINER_WEBHOOK')
                ]) {
                    sh '''
                        set +x
                        set -eu

                        # Confirms the RUNNING version, not what Portainer
                        # believes. The `version` label is already required on
                        # every service's metrics, so this adds no new surface
                        # and works for workers as well as APIs.
                        # TBD — Prometheus URL.
                        export VERSION_PROBE="curl -sf \"${PROMETHEUS_URL}/api/v1/query?query=up{service=\\"${APP_NAME}\\",environment=\\"dev\\"}\" | jq -r '.data.result[0].metric.version // empty'"

                        sh ./deploy-gitops.sh                           --service     "${APP_NAME}"                           --version     "${IMAGE_TAG}"                           --environment dev
                    '''
                }
            }
            post {
                failure {
                    // Exit 3 means it rolled back; exit 4 means the rollback
                    // ALSO failed and the desired state is wrong.
                    echo 'Deployment did not converge. Check whether the rollback succeeded — see docs/09-operations/rollback-runbook.md'
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'trivy-*.json, sbom-*.json, coverage.out',
                             allowEmptyArchive: true, fingerprint: true
            cleanWs()
        }
        failure {
            echo "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}"
        }
    }
}
