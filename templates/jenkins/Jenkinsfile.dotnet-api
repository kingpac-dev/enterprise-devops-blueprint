// =========================================================================
// Jenkinsfile — .NET Web API.
//
// Complete and runnable. See Jenkinsfile.template for the rationale behind
// the shared stages.
//
// STAGE ORDER DIFFERS FROM THE GENERIC TEMPLATE, and the difference is not
// cosmetic. The .NET Sonar scanner must WRAP build and test:
//
//     sonarscanner begin  ->  build  ->  test  ->  sonarscanner end
//
// It hooks the compiler to collect analysis during compilation. Running it
// after the build, as the generic template implies, produces an analysis
// with no results — and the gate then passes on nothing.
//
// DEPLOYMENT IS PULL-BASED. This pipeline does not connect to any
// runtime host. See adr/0010 and deploy-gitops.sh.
// =========================================================================

pipeline {

    agent { label 'linux-docker-dotnet' }   // TBD

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '50', artifactNumToKeepStr: '50'))
        skipDefaultCheckout(true)
    }

    environment {
        APP_NAME       = 'orders-api'                         // ADJUST
        PROJECT_PATH   = 'src/Orders.Api/Orders.Api.csproj'   // ADJUST
        SOLUTION_PATH  = 'Orders.sln'                         // ADJUST
        SONAR_KEY      = 'orders-api'                         // ADJUST
        HARBOR_URL     = 'harbor.example.internal'            // TBD
        HARBOR_PROJ    = 'my-team'                            // TBD
        SONAR_HOST     = 'https://sonarqube.example.internal' // TBD
        TRIVY_SEVERITY = 'HIGH,CRITICAL'                      // TBD
        // Keep the NuGet cache in the workspace so cleanWs() removes it and
        // packages are not shared between builds on a persistent agent.
        NUGET_PACKAGES = "${WORKSPACE}/.nuget"
        DOTNET_CLI_TELEMETRY_OPTOUT = '1'
        DOTNET_NOLOGO  = '1'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_COMMIT_SHORT = sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                }
            }
        }

        stage('Compute identity') {
            steps {
                script {
                    def branch = env.BRANCH_NAME ?: 'unknown'
                    if (branch == 'main' || branch.startsWith('release/')) {
                        env.VERSION    = readFile('VERSION').trim()
                        env.IMAGE_TAG  = "${env.VERSION}-${env.GIT_COMMIT_SHORT}"
                        env.PROMOTABLE = 'true'
                    } else if (branch == 'develop') {
                        env.VERSION    = '0.0.0'
                        env.IMAGE_TAG  = "sha-${env.GIT_COMMIT_SHORT}"
                        env.PROMOTABLE = 'true'
                    } else {
                        env.VERSION    = '0.0.0'
                        env.IMAGE_TAG  = "unpublished-${env.GIT_COMMIT_SHORT}"
                        env.PROMOTABLE = 'false'
                    }
                    env.IMAGE_REF       = "${env.HARBOR_URL}/${env.HARBOR_PROJ}/${env.APP_NAME}:${env.IMAGE_TAG}"
                    env.BUILD_TIMESTAMP = sh(script: 'date -u +%Y-%m-%dT%H:%M:%SZ', returnStdout: true).trim()
                }
            }
        }

        // -----------------------------------------------------------------
        // `--locked-mode` requires a committed packages.lock.json and fails
        // if it disagrees with the project file. Without it the same commit
        // can resolve different dependency versions on different days, and
        // "what is in this artifact" has no fixed answer.
        stage('Restore dependencies') {
            steps {
                sh '''
                    set -eu
                    dotnet restore "${SOLUTION_PATH}" --locked-mode
                '''
            }
        }

        // -----------------------------------------------------------------
        // BEGIN wraps build and test. See the header note.
        stage('Static analysis — begin') {
            steps {
                withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                    sh '''
                        set +x
                        set -eu
                        dotnet sonarscanner begin \
                          /k:"${SONAR_KEY}" \
                          /v:"${VERSION}" \
                          /d:sonar.host.url="${SONAR_HOST}" \
                          /d:sonar.token="${SONAR_TOKEN}" \
                          /d:sonar.cs.opencover.reportsPaths="**/coverage.opencover.xml" \
                          /d:sonar.cs.vstest.reportsPaths="**/*.trx"
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                // --no-incremental: an incremental build can skip compilation
                // of unchanged projects, and the Sonar scanner only sees what
                // is actually compiled.
                sh '''
                    set -eu
                    dotnet build "${SOLUTION_PATH}" \
                      --configuration Release \
                      --no-restore \
                      --no-incremental
                '''
            }
        }

        stage('Unit test and coverage') {
            steps {
                sh '''
                    set -eu
                    dotnet test "${SOLUTION_PATH}" \
                      --configuration Release \
                      --no-build \
                      --logger "trx" \
                      --collect:"XPlat Code Coverage" \
                      -- DataCollectionRunSettings.DataCollectors.DataCollector.Configuration.Format=opencover
                '''
            }
            post {
                always {
                    // mstest step from the MSTest plugin; adjust to your
                    // installed reporting plugin.
                    junit testResults: '**/*.trx', allowEmptyResults: true
                }
            }
        }

        stage('Static analysis — end') {
            steps {
                withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                    sh '''
                        set +x
                        set -eu
                        dotnet sonarscanner end /d:sonar.token="${SONAR_TOKEN}"
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // -----------------------------------------------------------------
        stage('Dependency and secret scan') {
            steps {
                sh '''
                    set -eu
                    trivy fs --config trivy.yaml \
                      --scanners vuln,secret,misconfig \
                      --severity "${TRIVY_SEVERITY}" \
                      --exit-code 1 \
                      .
                '''
            }
        }

        stage('Docker build') {
            steps {
                sh '''
                    set -eu
                    docker build \
                      --build-arg PROJECT_PATH="${PROJECT_PATH}" \
                      --build-arg VERSION="${VERSION}" \
                      --build-arg GIT_COMMIT="${GIT_COMMIT_SHORT}" \
                      --build-arg BUILD_TIMESTAMP="${BUILD_TIMESTAMP}" \
                      --build-arg REPOSITORY_URL="${GIT_URL}" \
                      --tag "${IMAGE_REF}" \
                      .
                '''
            }
        }

        stage('Container scan') {
            steps {
                sh '''
                    set -eu
                    trivy image --config trivy.yaml \
                      --severity "${TRIVY_SEVERITY}" --exit-code 1 "${IMAGE_REF}"
                    trivy image --config trivy.yaml \
                      --format json --output "trivy-${APP_NAME}-${IMAGE_TAG}.json" "${IMAGE_REF}"
                '''
            }
        }

        stage('Generate SBOM') {
            steps {
                sh '''
                    set -eu
                    trivy image --format cyclonedx \
                      --output "sbom-${APP_NAME}-${IMAGE_TAG}.cdx.json" "${IMAGE_REF}"
                '''
            }
        }

        stage('Push to Harbor') {
            when { environment name: 'PROMOTABLE', value: 'true' }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'harbor-push',
                    usernameVariable: 'HARBOR_USER',
                    passwordVariable: 'HARBOR_PASSWORD'
                )]) {
                    sh '''
                        set +x
                        set -eu
                        echo "${HARBOR_PASSWORD}" | docker login "${HARBOR_URL}" \
                            --username "${HARBOR_USER}" --password-stdin
                        set -x
                        docker push "${IMAGE_REF}"
                        docker logout "${HARBOR_URL}"
                    '''
                }
                script {
                    env.IMAGE_DIGEST = sh(
                        script: 'docker inspect --format "{{index .RepoDigests 0}}" "${IMAGE_REF}"',
                        returnStdout: true
                    ).trim()
                }
            }
        }

        // -----------------------------------------------------------------
        // -----------------------------------------------------------------
        // DEPLOY — pull-based. See adr/0010 and
        // docs/05-ci-cd/deployment-repository-standard.md
        //
        // This pipeline does NOT connect to a runtime host. It updates the
        // desired state in the deployment repository, asks Portainer to
        // synchronize, and WAITS FOR CONVERGENCE.
        //
        // The wait is the part a push model does not need. Without it the
        // pipeline cannot answer "did it deploy?", and rollback has no
        // trigger. deploy-gitops.sh reverts the desired state on timeout.
        //
        // [LIBRARY CANDIDATE] — identical in every pipeline.
        // -----------------------------------------------------------------
        stage('Deploy DEV') {
            when {
                allOf {
                    environment name: 'PROMOTABLE', value: 'true'
                    branch 'develop'
                }
            }
            steps {
                withCredentials([
                    string(credentialsId: 'deploy-repo-token', variable: 'DEPLOY_REPO_TOKEN'),
                    string(credentialsId: 'portainer-webhook-dev', variable: 'PORTAINER_WEBHOOK')
                ]) {
                    sh '''
                        set +x
                        set -eu

                        # Confirms the RUNNING version, not what Portainer
                        # believes. The `version` label is already required on
                        # every service's metrics, so this adds no new surface
                        # and works for workers as well as APIs.
                        # TBD — Prometheus URL.
                        export VERSION_PROBE="curl -sf \"${PROMETHEUS_URL}/api/v1/query?query=up{service=\\"${APP_NAME}\\",environment=\\"dev\\"}\" | jq -r '.data.result[0].metric.version // empty'"

                        sh ./deploy-gitops.sh                           --service     "${APP_NAME}"                           --version     "${IMAGE_TAG}"                           --environment dev
                    '''
                }
            }
            post {
                failure {
                    // Exit 3 means it rolled back; exit 4 means the rollback
                    // ALSO failed and the desired state is wrong.
                    echo 'Deployment did not converge. Check whether the rollback succeeded — see docs/09-operations/rollback-runbook.md'
                }
            }
        }

        // -----------------------------------------------------------------
        // MIGRATION — runs BEFORE the desired state is updated.
        //
        // This is option A in docs/05-ci-cd/database-migration-standard.md:
        // migrate, then release the version that needs it. A failed migration
        // means the tag is never committed, so NOTHING DEPLOYS — rather than
        // deploying and then breaking.
        //
        // CONSEQUENCE OF PULL-BASED DEPLOYMENT: between this stage and
        // Portainer converging, the PREVIOUS application version runs against
        // the NEW schema. That window is inherent to the model and is never
        // zero, so every migration must be backward compatible.
        // Expand/contract is structural here, not advisory.
        // -----------------------------------------------------------------
        stage('Database migration') {
            when { expression { return false } }   // TBD — tooling undecided
            steps {
                echo 'TBD — see docs/05-ci-cd/database-migration-standard.md. Before enabling: migration tooling chosen; a SEPARATE migration account holding CREATE/ALTER/DROP, used only by this stage; backup taken and VERIFIED for destructive changes; lock timeout set; migration class and rollback limitation stated in the release notes BEFORE approval.'
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'trivy-*.json, sbom-*.json',
                             allowEmptyArchive: true, fingerprint: true
            cleanWs()
        }
        failure {
            echo "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}"
        }
    }
}
